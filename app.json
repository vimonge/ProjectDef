{
  "expo": {
    "name": "ProjectDef",
    "slug": "projectdef",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "projectdef",
    "userInterfaceStyle": "light",
    "updates": {
      "url": "https://u.expo.dev/0fb7d5ba-b569-43b2-bc9a-229aefa70cb0",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow ProjectDef to turn your voice into defect notes.",
        "NSMicrophoneUsageDescription": "Allow ProjectDef to use the microphone to record defects by voice."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "au.com.mongestudio.projectdef",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15171C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow ProjectDef to use the microphone to record defects by voice.",
          "speechRecognitionPermission": "Allow ProjectDef to turn your voice into defect notes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0fb7d5ba-b569-43b2-bc9a-229aefa70cb0"
      }
    }
  }
}
